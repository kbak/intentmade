#!/usr/bin/env python3
"""Operate native OpenHands; no additional service or task database."""

import argparse
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "workflows"))
sys.path.insert(0, str(ROOT / "scripts"))
import deployment  # noqa: E402

# Ask Compose to resolve .env, exported overrides and relative bind paths.
# This keeps setup, deployment and image caching on the same configuration.
DEPLOYMENT = json.loads(
    subprocess.check_output(
        ["docker", "compose", "config", "--format", "json"], cwd=ROOT, text=True
    )
)
CANVAS = DEPLOYMENT["services"]["canvas"]
MOUNTS = {item["target"]: item["source"] for item in CANVAS["volumes"] if item["type"] == "bind"}
DATA = Path(MOUNTS["/workspaces"]).parent
CONFIG = Path(MOUNTS["/opt/factory/config"])
COMPOSE = ["docker", "compose"]


def run(*args, **kwargs):
    if args[:2] == ("docker", "compose"):
        args = (*COMPOSE, *args[2:])
    return subprocess.run(args, cwd=ROOT, check=True, **kwargs)


def native(*args, **kwargs):
    return run(
        "docker",
        "compose",
        "exec",
        "-T",
        "canvas",
        "python",
        "/opt/factory/configure.py",
        *args,
        **kwargs,
    )


def prepare_canvas_state():
    # Preserve native state when switching either direction between controller
    # images with different UIDs. Resolve ownership from the selected image.
    run("docker", "compose", "stop", "canvas")
    run(
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "--user",
        "0",
        "--entrypoint",
        "chown",
        "canvas",
        "-R",
        "--reference=/home/openhands",
        "/home/openhands/.openhands",
    )


def projects():
    defaults = json.loads((CONFIG / "defaults.json").read_text())
    options = deployment.settings(CONFIG)
    configured = {
        path.stem: deployment.workflow_settings(defaults, json.loads(path.read_text()))
        for path in (CONFIG / "repositories").glob("*.json")
    }
    for config in configured.values():
        if config.get("enabled") and config.get("repository"):
            deployment.check_issue_authorization(config, options)
    return configured


p = argparse.ArgumentParser(description=__doc__)
p.add_argument(
    "action",
    choices=[
        "init",
        "up",
        "down",
        "status",
        "open",
        "logs",
        "configure",
        "codex-login",
        "codex-logout",
        "submit",
        "plan",
        "export",
        "review",
        "retry-issue",
        "refresh",
        "projects",
        "factories",
    ],
)
p.add_argument("args", nargs=argparse.REMAINDER)
a = p.parse_args()
runtime = deployment.settings(CONFIG)["worker_runtime"]
native_backend = runtime["backend"] == "docker-sandboxes"
if native_backend and a.action == "up":
    import sandbox_compose

    resolved = sandbox_compose.resolve(DEPLOYMENT, runtime)
    # Compose itself resolves the base model; the override only adds host wiring.
    # Keep the rendered model out of the operator config and automation payloads.
    compose_file = tempfile.NamedTemporaryFile(mode="w", suffix=".json")
    json.dump(resolved, compose_file)
    compose_file.flush()
    COMPOSE = ["docker", "compose", "--project-directory", str(ROOT), "-f", compose_file.name]
if a.action == "init":
    DATA.mkdir(exist_ok=True, parents=True, mode=0o700)
    (DATA / "secrets").mkdir(exist_ok=True, mode=0o700)
    for name in ("canvas-key", "encryption-key"):
        path = DATA / "secrets" / name
        if not path.exists():
            path.write_text(secrets.token_urlsafe(32))
            path.chmod(0o444)
    for name in ("workspaces", "artifacts", "requests"):
        (DATA / name).mkdir(exist_ok=True)
        (DATA / name).chmod(0o777)
    (DATA / "catalog").mkdir(exist_ok=True)
    for name, project in projects().items():
        destination = DATA / "catalog" / name
        if destination.exists():
            continue
        if project["repository"]:
            run(
                "gh",
                "repo",
                "clone",
                project["repository"],
                str(destination),
                "--",
                "--branch",
                project["branch"],
            )
        else:
            shutil.copytree(CONFIG / project["fixture"], destination)
            run("git", "-C", str(destination), "init", "-b", project["branch"])
            run("git", "-C", str(destination), "add", ".")
            run(
                "git",
                "-C",
                str(destination),
                "-c",
                "user.name=Factory Fixture",
                "-c",
                "user.email=fixture@localhost",
                "commit",
                "-m",
                "Disposable test fixture",
            )
    print("Initialized. Start the services, then run factoryctl codex-login.")
elif a.action == "up" and native_backend:
    projects()
    sandbox_compose.prepare(ROOT, DEPLOYMENT, resolved, runtime)
    prepare_canvas_state()
    run(
        "docker",
        "compose",
        "up",
        "-d",
        "--no-build",
        "--remove-orphans",
        "--wait",
        "--wait-timeout",
        "300",
        "canvas",
    )
elif a.action == "up":
    image = CANVAS["image"]
    if image == "intentmade:dev":
        run("docker", "compose", "build", "canvas")
    else:
        # A supplied image may contain optional runtime dependencies. Never
        # replace it with Compose's default Dockerfile.
        run("docker", "image", "inspect", image, stdout=subprocess.DEVNULL)
    # Cache the matching worker image before Canvas can dispatch a scheduled job.
    run("docker", "compose", "up", "-d", "--wait", "--wait-timeout", "300", "sandboxes")
    # save/load loses registry digests in the nested daemon's classic image store.
    # Let Docker resolve and verify the pinned daemon image natively on a cache miss.
    daemon_image = DEPLOYMENT["services"]["sandboxes"]["image"]
    nested = ("docker", "compose", "exec", "-T", "sandboxes", "docker")
    try:
        run(
            *nested,
            "image",
            "inspect",
            daemon_image,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        run(*nested, "pull", daemon_image)
    with subprocess.Popen(["docker", "save", image], stdout=subprocess.PIPE) as source:
        run("docker", "compose", "exec", "-T", "sandboxes", "docker", "load", stdin=source.stdout)
        if source.wait():
            raise RuntimeError("Could not transfer sandbox images")
    prepare_canvas_state()
    run(
        "docker",
        "compose",
        "up",
        "-d",
        "--no-build",
        "--remove-orphans",
        "--wait",
        "--wait-timeout",
        "300",
    )
elif a.action == "configure":
    credential = run("gh", "auth", "token", capture_output=True, text=True).stdout
    native("github-login", input=credential, text=True)
    native("configure", *a.args)
elif a.action == "plan":
    planning = argparse.ArgumentParser(prog="factoryctl plan")
    planning.add_argument("project")
    planning.add_argument("spec")
    planning.add_argument("--intent", required=True)
    planning.add_argument("--plan", required=True)
    planning.add_argument("--task")
    planning.add_argument("--output", required=True)
    options = planning.parse_args(a.args)
    documents = {
        "intent.md": Path(options.intent).read_text(),
        "spec.md": Path(options.spec).read_text(),
        "plan.md": Path(options.plan).read_text(),
    }
    result = native(
        "plan",
        options.project,
        "-",
        *(["--task", options.task] if options.task else []),
        input=json.dumps(documents),
        text=True,
        capture_output=True,
    )
    package = json.loads(result.stdout)
    Path(options.output).write_text(json.dumps(package, indent=2) + "\n")
    print("Planning package saved:", options.output, "— task:", package["task"])
elif a.action == "export":
    from export_handoff import export

    if len(a.args) != 2:
        p.error("export requires RUN_TASK OUTPUT_DIRECTORY")
    export(Path(MOUNTS["/projects/artifacts"]), a.args[0], Path(a.args[1]))
elif a.action == "submit":
    if len(a.args) < 2:
        p.error(
            "submit requires REPOSITORY_OR_FACTORY SPEC_FILE [--task ID] [--run] [--no-publish]"
        )
    if "--inputs" in a.args:
        index = a.args.index("--inputs")
        if index + 1 >= len(a.args):
            p.error("--inputs requires a manifest file")
        a.args[index : index + 2] = ["--inputs-json", Path(a.args[index + 1]).read_text()]
    envelope = {"request": Path(a.args[1]).read_text()}
    if "--work-package" in a.args:
        index = a.args.index("--work-package")
        if index + 1 >= len(a.args):
            p.error("--work-package requires a JSON file")
        envelope["work_package"] = json.loads(Path(a.args[index + 1]).read_text())
        del a.args[index : index + 2]
    native(
        "submit",
        a.args[0],
        "-",
        *a.args[2:],
        "--submission-stdin",
        input=json.dumps(envelope),
        text=True,
    )
elif a.action in {"codex-login", "codex-logout"}:
    if a.args not in ([], ["--canvas"]):
        p.error(a.action + " accepts only --canvas (the separate coordinator login)")
    if native_backend and not a.args:
        import sandbox_compose

        command = sandbox_compose.native_command(runtime)
        operation = (
            ["set", "openai", "--oauth"]
            if a.action == "codex-login"
            else ["rm", "openai", "--force"]
        )
        run(command, "secret", *operation, env={**os.environ, "SBX_NO_TELEMETRY": "1"})
    else:
        native(a.action)
elif a.action == "review":
    native(a.action, *a.args)
elif a.action == "retry-issue":
    if "--answer-file" in a.args:
        index = a.args.index("--answer-file") + 1
        answer = Path(a.args[index]).read_text()
        a.args[index] = "-"
        native("retry-issue", *a.args, input=answer, text=True)
    else:
        native("retry-issue", *a.args)
elif a.action == "refresh":
    for name, project in projects().items():
        if project["repository"] and (not a.args or name in a.args):
            run("git", "-C", str(DATA / "catalog" / name), "pull", "--ff-only")
elif a.action == "projects":
    print(json.dumps(projects(), indent=2))
elif a.action == "factories":
    native("factories")
elif a.action == "open":
    address = run(
        "docker", "compose", "port", "canvas", "8000", capture_output=True, text=True
    ).stdout.strip()
    print("http://" + address + "/canvas")
elif a.action == "status":
    run("docker", "compose", "ps")
elif a.action == "logs":
    run("docker", "compose", "logs", "--tail", "100", "canvas")
else:
    run("docker", "compose", "down")
