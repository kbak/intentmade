#!/bin/sh
# Keep saved ACP commands working while loading roles through Node's native preload.
# Explicit factory MCP servers take precedence over ignored repository config.
export DISABLE_MCP_CONFIG_FILTERING=true
exec /acp-node/bin/node --import=/opt/factory/factory-agents.mjs /acp-node/lib/node_modules/@agentclientprotocol/codex-acp/dist/index.js "$@"
