# Copy to .env and set these paths for your installation.
# Paths are relative to the tooling checkout, or may be absolute.
FACTORY_DATA_DIR=../my-factory/.factory
FACTORY_CONFIG_DIR=../my-factory/config
FACTORY_PROFILES_DIR=../my-factory/profiles

# Optional overrides.
# COMPOSE_PROJECT_NAME is Docker Compose's standard deployment name setting.
COMPOSE_PROJECT_NAME=intentmade
CANVAS_PORT=8000
FACTORY_IMAGE=intentmade:dev
