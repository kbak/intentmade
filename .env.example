# Optional overrides. A single local deployment works with the defaults.
# COMPOSE_PROJECT_NAME is Docker Compose's standard deployment name setting.
COMPOSE_PROJECT_NAME=openhands-factory
CANVAS_PORT=8000
FACTORY_DATA_DIR=../factory-deployment/.factory
FACTORY_CONFIG_DIR=../factory-deployment/config
FACTORY_PROFILES_DIR=../factory-deployment/profiles
FACTORY_IMAGE=openhands-factory:dev
